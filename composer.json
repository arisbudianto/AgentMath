{
  "name": "arisbudianto/agentmath",
  "type": "project",
  "description": "Teacher-supervised mathematics grading",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.17"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5.12",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.6"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "test": "@php artisan test"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  }
}
